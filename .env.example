# AI provider: mock | gigachat | openai
# mock = rule-based demo without external AI.
# gigachat = real AI via GigaChat REST API.
# openai = real AI via OpenAI Responses API.
AI_PROVIDER=mock

# Backward-compatible flag from earlier versions.
# If true, mock mode is used even when API keys exist.
USE_MOCK_AI=true

# ---------- GigaChat ----------
# Authorization key from Sber Developers.
# You can paste either raw base64 key or full value with "Basic ...".
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1

# Use only for local development if Node cannot validate GigaChat certificates.
# Safer option: configure NODE_EXTRA_CA_CERTS with the required certificate.
GIGACHAT_DISABLE_TLS_REJECT=false

# ---------- OpenAI fallback / alternative ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# ---------- Leads ----------
# Optional: send leads to Telegram in addition to local data/leads.jsonl logging.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: send lead notifications to email. Recipient defaults to info@nexaire.ru.
LEAD_EMAIL_TO=info@nexaire.ru
LEAD_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
